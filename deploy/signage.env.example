# Параметры сетевого диска для Signage. На сервере: /etc/signage/signage.env (права 600).
# Файл пишет deploy/install.sh. После ручной правки: signage smb

SMB_HOST='10.33.44.5'
SMB_SHARE='signage'
SMB_USER='signage'
SMB_PASSWORD='change-me'
# Домен (если учётная запись доменная), иначе пусто
SMB_DOMAIN=''
# Версия протокола: 3.0 (Windows Server 2012+, современные NAS) или 2.1
SMB_VERS=3.0
# Шара монтируется в $SMB_ROOT/share
SMB_ROOT=/srv/signage-smb
# Пользователь, от имени которого работает сервер
SIGNAGE_USER=signage
