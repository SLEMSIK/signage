# Переменные для docker compose и deploy/setup-smb.sh. Скопируйте в .env.

# Порт на хосте (VM), на котором будет доступен сервер
PORT=8080

# Сетевой диск SMB с медиатекой: //SMB_HOST/SMB_SHARE.
# После изменения выполните: sudo ./deploy/setup-smb.sh
SMB_HOST=10.33.44.5
SMB_SHARE=signage
SMB_USER=signage
SMB_PASSWORD=change-me
# Домен (если учётная запись доменная), иначе оставьте пустым
SMB_DOMAIN=
# Версия протокола SMB (3.0 подходит для Windows Server 2012+ и современных NAS)
SMB_VERS=3.0
# Каталог на VM: шара монтируется в $SMB_ROOT/share, в контейнере это /data/smb/share
SMB_ROOT=/srv/signage-smb
