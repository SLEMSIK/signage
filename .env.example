# Переменные для docker compose. Скопируйте в .env.

# Порт на хосте (VM), на котором будет доступен сервер
PORT=8080

# Сетевой диск SMB с медиатекой: //SMB_HOST/SMB_SHARE
SMB_HOST=10.33.44.5
SMB_SHARE=signage
SMB_USER=signage
SMB_PASSWORD=change-me
# Версия протокола SMB (3.0 подходит для Windows Server 2012+ и современных NAS)
SMB_VERS=3.0
